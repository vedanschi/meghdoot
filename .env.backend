# Meghdoot backend deployment environment
#
# These values describe the production artifacts so Cloud Run and the local
# backend path use the same references.

MEGHDOOT_GCS_BUCKET=meghdoot-satellite-data

# Production model artifacts stored in GCS.
MEGHDOOT_VAE_CHECKPOINT_GCS_URI=gs://meghdoot-satellite-data/vae_final/vae_final.pt
MEGHDOOT_DIFFUSION_CHECKPOINT_GCS_URI=gs://meghdoot-satellite-data/production/meghdoot_epoch290_prod.pt

# Optional explicit bucket/prefix fallbacks for hydration.
MEGHDOOT_VAE_CHECKPOINT_BUCKET=meghdoot-satellite-data
MEGHDOOT_VAE_CHECKPOINT_PREFIX=vae_final/
MEGHDOOT_DIFFUSION_CHECKPOINT_BUCKET=meghdoot-satellite-data
MEGHDOOT_DIFFUSION_CHECKPOINT_PREFIX=production/

# Cloud Run runtime defaults.
MEGHDOOT_DEVICE=cuda
MEGHDOOT_RUNTIME_DIR=/tmp/meghdoot