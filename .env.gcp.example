# Copy this to .env.gcp and fill values.
# This file is used by scripts/setup_gcp_stack.sh

PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Cloud Run service names
BACKEND_SERVICE_NAME=meghdoot-backend
FRONTEND_SERVICE_NAME=meghdoot-frontend

# Scheduler
SCHEDULER_JOB_NAME=meghdoot-nowcast
SCHEDULER_CRON=*/30 * * * *
SCHEDULER_TIME_ZONE=UTC

# Service accounts (account ids, not emails)
BACKEND_RUNTIME_SA_NAME=meghdoot-runtime
SCHEDULER_SA_NAME=meghdoot-scheduler

# Optional MOSDAC Secret Manager secret names.
# If provided, backend deploy script maps them to MOSDAC_USERNAME / MOSDAC_PASSWORD.
MOSDAC_USERNAME_SECRET=
MOSDAC_PASSWORD_SECRET=

# Optional tuning
BACKEND_ALLOW_UNAUTHENTICATED=0
